# The Telegram URL to redirect to
# Examples:
#   Channel:  https://t.me/yourchannel
#   Group:    https://t.me/yourgroup
#   User:     https://t.me/yourusername
#   Bot:      https://t.me/yourbotname
TELEGRAM_URL=https://t.me/YOUR_TELEGRAM_USERNAME

# Server port (Render sets this automatically)
PORT=3000

# Optional: delay before auto-redirect (seconds)
REDIRECT_SECONDS=5
